{
  "name": "agenthawk-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first dependency admission control for AI coding agents.",
  "license": "Apache-2.0",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "scripts": {
    "agenthawk": "pnpm --filter @agenthawk/cli dev",
    "build": "pnpm -r build",
    "format": "biome format --write .",
    "lint": "biome check .",
    "package:check": "pnpm build && node scripts/verify-package-contents.mjs",
    "release:prepare": "node scripts/prepare-release-artifacts.mjs",
    "verify:codex-app-server": "pnpm build && node scripts/verify-codex-app-server.mjs",
    "verify:codex-project-activation": "pnpm build && node scripts/verify-codex-app-server.mjs --project-activation",
    "verify:codex-host": "pnpm build && node scripts/verify-codex-host.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "pnpm --filter @agenthawk/core build && pnpm -r typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@types/node": "26.2.0",
    "@vitest/coverage-v8": "4.1.11",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}

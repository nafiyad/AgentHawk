{
  "name": "@agenthawk/cli",
  "version": "0.1.0-alpha.1",
  "type": "module",
  "description": "Command-line interface for AgentHawk.",
  "homepage": "https://github.com/nafiyad/AgentHawk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nafiyad/AgentHawk.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/nafiyad/AgentHawk/issues"
  },
  "license": "Apache-2.0",
  "contentPolicy": {
    "class": "dual-use"
  },
  "engines": {
    "node": "^22.0.0 || ^24.0.0"
  },
  "bin": {
    "agenthawk": "./dist/index.js",
    "agenthawk-claude-pretooluse": "./dist/claude-pretooluse-entry.js",
    "agenthawk-codex-pretooluse": "./dist/codex-pretooluse-entry.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "DISCLOSURE"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/",
    "tag": "alpha"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@agenthawk/core": "workspace:*",
    "commander": "15.0.0",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2"
  }
}
